.stroke-fg { stroke: #00000f; }
.fill-bg { fill: #ffffff; }
.stroke-bg { stroke: #ffffff; }
.fill-strong { fill: #111133; }
.fill-weak { fill: gray; }
.stroke-weak { stroke: gray; }
.radar {
stroke-width: 4px;
stroke: #47a042;
fill: #47a042;
fill-opacity: 0.5;
}
