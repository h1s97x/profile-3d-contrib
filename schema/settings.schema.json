{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/h1s97x/github-profile-3d-contrib/main/schema/settings.schema.json",
  "title": "github-profile-3d-contrib settings",
  "description": "Settings JSON for the SETTING_JSON input of github-profile-3d-contrib. Either a single settings object or an array of settings objects.",
  "oneOf": [
    { "$ref": "#/definitions/settings" },
    {
      "type": "array",
      "items": { "$ref": "#/definitions/settings" },
      "minItems": 1
    }
  ],
  "definitions": {
    "color": {
      "type": "string",
      "description": "Hex color (\"#47a042\"), CSS color name (\"gray\"), CSS function (\"rgb(255,200,55)\") or percentage (\"20%\")",
      "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+(\\([0-9\\s.,%]+\\))?|[0-9]+(\\.[0-9]+)?%)$"
    },
    "fiveColors": {
      "type": "array",
      "items": { "$ref": "#/definitions/color" },
      "minItems": 5,
      "maxItems": 5
    },
    "fileName": {
      "type": "string",
      "description": "Output file name (plain name only, no path separators)",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$"
    },
    "l10n": {
      "type": "object",
      "description": "Localized labels for the radar chart",
      "properties": {
        "commit": { "type": "string" },
        "repo": { "type": "string" },
        "review": { "type": "string" },
        "pullreq": { "type": "string" },
        "issue": { "type": "string" },
        "contrib": { "type": "string" }
      },
      "additionalProperties": false
    },
    "panelPattern": {
      "type": "object",
      "required": ["width", "bitmap"],
      "properties": {
        "width": { "type": "number" },
        "bitmap": {
          "type": "array",
          "items": { "type": ["number", "string"] }
        },
        "backgroundColor": { "$ref": "#/definitions/color" },
        "foregroundColor": { "$ref": "#/definitions/color" }
      }
    },
    "contribPattern": {
      "type": "object",
      "required": ["top", "left", "right"],
      "properties": {
        "top": { "$ref": "#/definitions/panelPattern" },
        "left": { "$ref": "#/definitions/panelPattern" },
        "right": { "$ref": "#/definitions/panelPattern" }
      }
    },
    "base": {
      "type": "object",
      "required": [
        "type",
        "backgroundColor",
        "foregroundColor",
        "strongColor",
        "weakColor",
        "radarColor"
      ],
      "properties": {
        "$schema": { "type": "string" },
        "backgroundColor": { "$ref": "#/definitions/color" },
        "foregroundColor": { "$ref": "#/definitions/color" },
        "strongColor": { "$ref": "#/definitions/color" },
        "weakColor": { "$ref": "#/definitions/color" },
        "radarColor": { "$ref": "#/definitions/color" },
        "growingAnimation": { "type": "boolean" },
        "fileName": { "$ref": "#/definitions/fileName" },
        "l10n": { "$ref": "#/definitions/l10n" }
      }
    },
    "settings": {
      "oneOf": [
        { "$ref": "#/definitions/normal" },
        { "$ref": "#/definitions/season" },
        { "$ref": "#/definitions/rainbow" },
        { "$ref": "#/definitions/bitmap" },
        { "$ref": "#/definitions/pieLangOnly" },
        { "$ref": "#/definitions/radarContribOnly" }
      ]
    },
    "normal": {
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "required": ["type", "contribColors"],
          "properties": {
            "type": { "const": "normal" },
            "contribColors": { "$ref": "#/definitions/fiveColors" },
            "darkMode": { "$ref": "#/definitions/normal" }
          }
        }
      ]
    },
    "season": {
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "required": [
            "type",
            "contribColors1",
            "contribColors2",
            "contribColors3",
            "contribColors4"
          ],
          "properties": {
            "type": { "const": "season" },
            "contribColors1": { "$ref": "#/definitions/fiveColors" },
            "contribColors2": { "$ref": "#/definitions/fiveColors" },
            "contribColors3": { "$ref": "#/definitions/fiveColors" },
            "contribColors4": { "$ref": "#/definitions/fiveColors" },
            "darkMode": { "$ref": "#/definitions/season" }
          }
        }
      ]
    },
    "rainbow": {
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "required": [
            "type",
            "saturation",
            "contribLightness",
            "duration",
            "hueRatio"
          ],
          "properties": {
            "type": { "const": "rainbow" },
            "saturation": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?%$" },
            "contribLightness": { "$ref": "#/definitions/fiveColors" },
            "duration": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s)$" },
            "hueRatio": { "type": "number" },
            "darkMode": { "$ref": "#/definitions/rainbow" }
          }
        }
      ]
    },
    "bitmap": {
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "required": ["type", "contribPatterns"],
          "properties": {
            "type": { "const": "bitmap" },
            "contribPatterns": {
              "type": "array",
              "items": { "$ref": "#/definitions/contribPattern" },
              "minItems": 5,
              "maxItems": 5
            },
            "darkMode": { "$ref": "#/definitions/bitmap" }
          }
        }
      ]
    },
    "pieLangOnly": {
      "type": "object",
      "required": ["type", "backgroundColor", "foregroundColor"],
      "properties": {
        "$schema": { "type": "string" },
        "type": { "const": "pie_lang_only" },
        "backgroundColor": { "$ref": "#/definitions/color" },
        "foregroundColor": { "$ref": "#/definitions/color" },
        "growingAnimation": { "type": "boolean" },
        "fileName": { "$ref": "#/definitions/fileName" },
        "darkMode": { "$ref": "#/definitions/pieLangOnly" }
      }
    },
    "radarContribOnly": {
      "type": "object",
      "required": [
        "type",
        "backgroundColor",
        "foregroundColor",
        "weakColor",
        "radarColor"
      ],
      "properties": {
        "$schema": { "type": "string" },
        "type": { "const": "radar_contrib_only" },
        "backgroundColor": { "$ref": "#/definitions/color" },
        "foregroundColor": { "$ref": "#/definitions/color" },
        "weakColor": { "$ref": "#/definitions/color" },
        "radarColor": { "$ref": "#/definitions/color" },
        "growingAnimation": { "type": "boolean" },
        "fileName": { "$ref": "#/definitions/fileName" },
        "l10n": {
          "type": "object",
          "properties": {
            "commit": { "type": "string" },
            "repo": { "type": "string" },
            "review": { "type": "string" },
            "pullreq": { "type": "string" },
            "issue": { "type": "string" }
          },
          "additionalProperties": false
        },
        "darkMode": { "$ref": "#/definitions/radarContribOnly" }
      }
    }
  }
}
